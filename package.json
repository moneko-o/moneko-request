{
  "name": "@moneko/request",
  "version": "1.7.0-beta.0",
  "description": "A lightweight and flexible request library for Node.js and browsers",
  "main": "./cjs/index.cjs",
  "module": "./esm/index.mjs",
  "browser": "./esm/index.mjs",
  "exports": {
    ".": {
      "node": {
        "import": "./esm/node.mjs",
        "require": "./cjs/node.cjs"
      },
      "browser": {
        "import": "./esm/index.mjs",
        "require": "./cjs/index.cjs"
      },
      "default": {
        "import": "./esm/index.mjs",
        "require": "./cjs/index.cjs"
      }
    }
  },
  "scripts": {
    "prepack": "node ./build.mjs",
    "build": "node ./build.mjs"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moneko-o/moneko-request.git"
  },
  "bugs": {
    "url": "https://github.com/moneko-o/moneko-request/issues"
  },
  "engines": {
    "node": ">=14.16"
  },
  "keywords": [
    "http",
    "request",
    "fetch",
    "nodejs",
    "browser"
  ],
  "author": "moneko <poi.nyaa@qq.com>",
  "license": "MIT",
  "files": [
    "esm",
    "cjs"
  ],
  "devDependencies": {
    "@moneko/convert": "1.3.0",
    "@swc/core": "1.15.21",
    "@types/node": "25.5.0",
    "@moneko/eslint": "1.11.2"
  }
}
